# Demo / contact form delivery (first match wins):
#  1. VITE_LEAD_ENDPOINT  - HTTPS endpoint that receives a JSON POST (your own API, Zapier/Make webhook, etc.)
#  2. VITE_NETLIFY_FORMS  - "true" sends to Netlify Forms; already set for Netlify builds in netlify.toml
#  3. neither (production) - opens a pre-filled email to SITE.contact.email; (development) logs to the console
VITE_LEAD_ENDPOINT=
VITE_NETLIFY_FORMS=
