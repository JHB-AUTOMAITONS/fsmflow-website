# Apache hosting: serve prerendered clean URLs (/solutions/cctv-software → .../index.html)
# without redirecting, and use the prerendered 404 page.
DirectorySlash Off
Options -Indexes
RewriteEngine On

# Canonical host + HTTPS (uncomment once the domain is live)
# RewriteCond %{HTTPS} off [OR]
# RewriteCond %{HTTP_HOST} ^www\. [NC]
# RewriteRule ^ https://fsmflow.in%{REQUEST_URI} [L,R=301]

# /path/  →  /path  (single canonical form, no trailing slash)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [L,R=301]

# /path  →  /path/index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+?)/?$ /$1/index.html [L]

ErrorDocument 404 /404.html

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
