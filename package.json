{
  "name": "fsmflow-website",
  "private": true,
  "version": "1.0.0",
  "description": "FSMFlow.in — marketing website for the FSMFlow field service management platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "build": "tsc -b && npm run build:client && npm run build:server && npm run prerender",
    "preview": "node scripts/serve.mjs",
    "audit:seo": "node scripts/audit-seo.mjs",
    "lint": "oxlint"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "oxlint": "^1.87.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.3"
  }
}
